{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signbridge.local/schemas/analysis_result.schema.json",
  "title": "SignBridge Analysis Result",
  "description": "CV识别、动作评分与错误诊断输出给Agent/Web的统一结构。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "target",
    "recognition",
    "quality",
    "evaluation",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "$ref": "#/$defs/signRef"
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction",
        "confidence",
        "top3"
      ],
      "properties": {
        "prediction": {
          "$ref": "#/$defs/signRefOrUnknown"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top3": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sign",
              "confidence"
            ],
            "properties": {
              "sign": {
                "$ref": "#/$defs/signRefOrUnknown"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_usable",
        "landmark_valid_ratio",
        "duration_sec"
      ],
      "properties": {
        "input_usable": {
          "type": "boolean"
        },
        "landmark_valid_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duration_sec": {
          "type": "number",
          "minimum": 0
        },
        "fps": {
          "type": "number",
          "minimum": 0
        },
        "sequence_length": {
          "type": "integer",
          "minimum": 1
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall"
      ],
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "handshape": {
          "$ref": "#/$defs/scoreItem"
        },
        "trajectory": {
          "$ref": "#/$defs/scoreItem"
        },
        "position": {
          "$ref": "#/$defs/scoreItem"
        },
        "tempo": {
          "$ref": "#/$defs/scoreItem"
        },
        "amplitude": {
          "$ref": "#/$defs/scoreItem"
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/errorEvent"
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "signRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sign_id",
        "label"
      ],
      "properties": {
        "sign_id": {
          "type": "string",
          "pattern": "^CSL_[A-Z0-9_]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signRefOrUnknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sign_id",
        "label"
      ],
      "properties": {
        "sign_id": {
          "type": "string",
          "pattern": "^(CSL_[A-Z0-9_]+|UNKNOWN)$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scoreItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "end_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "start_sec": {
          "type": "number",
          "minimum": 0
        },
        "end_sec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "expected_min": {
          "type": "number"
        },
        "expected_max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "errorEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "body_part",
        "dimension",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "body_part": {
          "type": "string",
          "enum": [
            "left_hand",
            "right_hand",
            "both_hands",
            "head",
            "upper_body",
            "global",
            "active_hand"
          ]
        },
        "dimension": {
          "type": "string",
          "enum": [
            "handshape",
            "trajectory",
            "position",
            "tempo",
            "amplitude",
            "quality",
            "recognition"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "preparation",
            "start",
            "main_motion",
            "end",
            "global"
          ]
        },
        "severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "time_range": {
          "$ref": "#/$defs/timeRange"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  }
}