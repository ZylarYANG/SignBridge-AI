                    }
                    onClick={() =>
                      setSelectedSignId(
                        sign.signId
                      )
                    }
                  >
                    <span>
                      {sign.label}
                    </span>

                    <strong>
                      {usable}
                      {" / "}
                      {
                        targetTakes
                      }
                    </strong>

                    {bad > 0 && (
                      <small className="danger-text">
                        ⚠ {bad}
                      </small>
                    )}
                  </button>
                );
              }
            )}

