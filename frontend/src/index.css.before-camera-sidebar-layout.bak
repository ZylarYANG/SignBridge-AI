:root {
  font-family:
    Inter,
    "Segoe UI",
    "Microsoft YaHei",
    sans-serif;

  color: #172033;
  background: #f5f7fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

button {
  font: inherit;
}

.app-shell {
  width: min(1400px, calc(100% - 48px));
  margin: 0 auto;
  padding: 36px 0 64px;
}

.app-header {
  margin-bottom: 28px;
}

.eyebrow {
  display: inline-block;
  margin-bottom: 8px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #52616f;
}

.app-header h1 {
  margin: 0;
  font-size: clamp(30px, 4vw, 48px);
}

.app-header p {
  margin: 10px 0 0;
  color: #637083;
}

.workspace {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
  gap: 24px;
  align-items: start;
}

.camera-panel,
.practice-panel {
  background: white;
  border: 1px solid #e4e8ef;
  border-radius: 22px;
  box-shadow: 0 16px 42px rgba(25, 35, 55, 0.08);
}

.camera-panel {
  padding: 20px;
}

.camera-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.camera-header h2 {
  margin: 0;
  font-size: 20px;
}

.camera-header p {
  margin: 6px 0 0;
  color: #697689;
}

.status {
  flex: none;
  padding: 7px 11px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 700;
  background: #edf0f4;
}

.status-ready {
  background: #e8f7ee;
}

.status-permission-denied,
.status-error {
  background: #fdecec;
}

.video-shell {
  position: relative;
  overflow: hidden;
  aspect-ratio: 16 / 9;
  border-radius: 18px;
  background: #111827;
}

.camera-video {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;

  /*
   * 仅镜像显示。
   * 后续 MediaPipe 数据不要因此交换左右手语义。
   */
  transform: scaleX(-1);
}

.camera-guide {
  pointer-events: none;
  position: absolute;
  inset: 8% 22%;
  opacity: 0.25;
}

.guide-head {
  width: 18%;
  aspect-ratio: 1;
  margin: 0 auto;
  border: 2px dashed white;
  border-radius: 50%;
}

.guide-body {
  width: 70%;
  height: 72%;
  margin: 3% auto 0;
  border: 2px dashed white;
  border-radius: 45% 45% 24% 24%;
}

.practice-panel {
  padding: 24px;
}

.panel-label {
  font-size: 13px;
  color: #788599;
}

.practice-panel h2 {
  margin: 8px 0 2px;
  font-size: 34px;
}

.practice-panel code {
  color: #637083;
}

.metric {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 20px;
  padding: 14px 0;
  border-top: 1px solid #edf0f4;
}

.metric span {
  color: #778397;
}

.practice-panel button {
  width: 100%;
  margin-top: 24px;
  border: 0;
  border-radius: 12px;
  padding: 14px;
}

.hint,
.error-message {
  margin: 16px 0 0;
  line-height: 1.6;
  color: #697689;
}

.error-message {
  color: #a72f2f;
}

@media (max-width: 850px) {
  .workspace {
    grid-template-columns: 1fr;
  }

  .app-shell {
    width: min(100% - 24px, 1400px);
    padding-top: 20px;
  }
}

.status-stack {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: flex-end;
}

.landmark-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;

  /*
   * video 本身做了镜像显示，
   * canvas 同样镜像，
   * 因而关键点与人物视觉上保持重合。
   */
  transform: scaleX(-1);
}

.vision-metrics {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 12px;
  margin-top: 16px;
}

.vision-metric {
  padding: 12px 14px;
  border: 1px solid #edf0f4;
  border-radius: 12px;
  background: #f8fafc;
}

.vision-metric span {
  display: block;
  margin-bottom: 4px;
  font-size: 12px;
  color: #7b8797;
}

.vision-metric strong {
  font-size: 14px;
}

@media (max-width: 650px) {
  .vision-metrics {
    grid-template-columns: 1fr;
  }
}

.capture-overlay {
  position: absolute;
  inset: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  pointer-events: none;

  font-size: clamp(
    44px,
    8vw,
    90px
  );

  font-weight: 800;

  color: white;

  background:
    rgba(10, 16, 28, 0.3);

  text-shadow:
    0 4px 18px
    rgba(0, 0, 0, 0.5);
}

.capture-overlay-recording {
  align-items: flex-start;
  justify-content: flex-start;

  padding: 22px;

  font-size: 18px;

  background:
    rgba(0, 0, 0, 0.05);
}

.capture-controls {
  display: grid;

  grid-template-columns:
    1fr
    1fr
    1fr
    minmax(160px, auto);

  gap: 12px;

  align-items: center;

  margin-top: 16px;

  padding: 16px;

  border:
    1px solid #edf0f4;

  border-radius: 14px;

  background: #f8fafc;
}

.capture-controls > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.capture-label {
  font-size: 12px;
  color: #7b8797;
}

.primary-button {
  min-height: 46px;

  border: none;

  border-radius: 12px;

  padding: 12px 18px;

  cursor: pointer;

  font-weight: 700;

  color: white;

  background: #172033;
}

.primary-button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

@media (max-width: 750px) {
  .capture-controls {
    grid-template-columns:
      1fr
      1fr;
  }
}

.api-result,
.api-error {
  margin-top: 16px;
  padding: 16px;

  border-radius: 14px;
}

.api-result {
  border:
    1px solid #cce8d5;

  background:
    #f2fbf5;
}

.api-error {
  border:
    1px solid #f0cccc;

  background:
    #fff5f5;
}

.api-result strong,
.api-error strong {
  display: block;

  margin-bottom: 8px;
}

.api-result p,
.api-error p {
  margin: 5px 0;
}

/* ========================================
   Day 2 · Collection Mode
   ======================================== */

.mode-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: 8px;

  margin-bottom: 18px;

  padding: 5px;

  border-radius: 14px;

  background: #eef2f7;
}

.mode-button {
  min-height: 42px;

  border: none;

  border-radius: 10px;

  cursor: pointer;

  font-weight: 700;

  color: #667085;

  background: transparent;
}

.mode-button:hover:not(:disabled) {
  background: rgba(
    255,
    255,
    255,
    0.65
  );
}

.mode-button-active {
  color: #172033;

  background: white;

  box-shadow:
    0 2px 8px
    rgba(15, 23, 42, 0.08);
}

.mode-button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}


.collection-panel {
  display: grid;

  grid-template-columns:
    minmax(150px, 0.8fr)
    minmax(220px, 1.5fr)
    minmax(110px, 0.5fr);

  gap: 14px;

  margin-bottom: 18px;

  padding: 16px;

  border:
    1px solid #e5eaf0;

  border-radius: 16px;

  background: #f8fafc;
}


.collection-field {
  display: flex;

  flex-direction: column;

  gap: 7px;
}


.collection-field label {
  font-size: 12px;

  font-weight: 700;

  color: #344054;
}


.collection-field input,
.collection-field select,
.practice-target select {
  width: 100%;

  min-height: 42px;

  box-sizing: border-box;

  border:
    1px solid #d8dee8;

  border-radius: 10px;

  padding:
    9px 11px;

  outline: none;

  color: #172033;

  background: white;
}


.collection-field input:focus,
.collection-field select:focus,
.practice-target select:focus {
  border-color: #98a8c3;

  box-shadow:
    0 0 0 3px
    rgba(91, 113, 150, 0.1);
}


.collection-field small {
  min-height: 30px;

  line-height: 1.45;

  color: #7b8797;
}


.sample-preview {
  grid-column:
    1 / -1;

  display: flex;

  align-items: center;

  gap: 12px;

  padding-top: 4px;
}


.sample-preview span {
  font-size: 12px;

  font-weight: 700;

  color: #667085;
}


.sample-preview code {
  padding:
    6px 10px;

  border-radius: 8px;

  overflow-wrap: anywhere;

  background: #e9eef5;
}


.practice-target {
  display: grid;

  grid-template-columns:
    auto auto auto
    minmax(220px, 1fr);

  gap: 12px;

  align-items: center;

  margin-bottom: 18px;

  padding: 14px 16px;

  border:
    1px solid #e5eaf0;

  border-radius: 14px;

  background: #f8fafc;
}


.practice-target span {
  font-size: 12px;

  color: #7b8797;
}


.practice-target code {
  padding:
    5px 8px;

  border-radius: 7px;

  background: #e9eef5;
}


.dataset-result {
  margin-top: 16px;

  padding: 16px;

  border:
    1px solid #b9dfc6;

  border-radius: 14px;

  background: #edf9f1;
}


.dataset-result strong {
  display: block;

  margin-bottom: 9px;
}


.dataset-result p {
  margin:
    5px 0;

  overflow-wrap: anywhere;

  color: #425466;
}


@media (
  max-width: 850px
) {
  .collection-panel {
    grid-template-columns:
      1fr;
  }

  .sample-preview {
    grid-column: auto;
  }

  .practice-target {
    grid-template-columns:
      1fr;
  }
}


@media (
  max-width: 560px
) {
  .mode-switch {
    grid-template-columns:
      1fr;
  }
}



/* ========================================
   Collection Workbench v3
   ======================================== */

.collector-toolbar {
  display: grid;
  grid-template-columns:
    minmax(160px, 0.8fr)
    minmax(220px, 1fr)
    minmax(260px, 1.3fr);

  gap: 14px;

  margin-bottom: 14px;
  padding: 14px;

  border: 1px solid #e3e8ef;
  border-radius: 14px;

  background: #f8fafc;
}

.collector-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.collector-field label,
.collector-options > label:first-child {
  font-size: 12px;
  font-weight: 700;
  color: #475467;
}

.collector-field input {
  min-height: 42px;
  padding: 8px 10px;

  border: 1px solid #d8dee8;
  border-radius: 9px;

  background: white;
}

.quick-signers {
  display: flex;
  align-items: end;
  gap: 7px;
}

.quick-signer,
.countdown-option {
  min-height: 38px;
  padding: 7px 12px;

  border: 1px solid #d8dee8;
  border-radius: 9px;

  cursor: pointer;

  background: white;
}

.quick-signer-active,
.countdown-option-active {
  border-color: #61779b;
  font-weight: 700;

  box-shadow:
    0 0 0 2px
    rgba(97, 119, 155, 0.12);
}

.collector-options {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.countdown-options {
  display: flex;
  gap: 5px;
}

.auto-advance-option {
  display: flex;
  align-items: center;

  gap: 6px;

  margin-left: 8px;

  font-size: 12px;
  color: #475467;
}


.collection-summary {
  display: grid;
  grid-template-columns:
    repeat(
      4,
      minmax(100px, 1fr)
    );

  gap: 10px;

  margin-bottom: 14px;
}

.collection-summary > div {
  display: flex;
  flex-direction: column;
  gap: 4px;

  padding: 12px;

  border: 1px solid #e3e8ef;
  border-radius: 12px;

  background: white;
}

.collection-summary span {
  font-size: 12px;
  color: #667085;
}

.collection-summary strong {
  font-size: 20px;
}


.sign-progress-grid {
  display: grid;

  grid-template-columns:
    repeat(
      auto-fit,
      minmax(105px, 1fr)
    );

  gap: 7px;

  margin-bottom: 14px;
}

.sign-progress-card {
  position: relative;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  gap: 4px;

  min-height: 64px;

  padding: 9px;

  border: 1px solid #e0e5ec;
  border-radius: 10px;

  cursor: pointer;

  color: #475467;
  background: white;
}

.sign-progress-card-active {
  border-color: #61779b;

  box-shadow:
    0 0 0 2px
    rgba(97, 119, 155, 0.12);
}

.sign-progress-card span {
  font-size: 13px;
}

.sign-progress-card strong {
  font-size: 16px;
}


.target-action-card {
  display: grid;
  grid-template-columns:
    minmax(180px, 1.2fr)
    minmax(220px, 1.4fr)
    minmax(200px, 1fr)
    auto;

  align-items: center;

  gap: 16px;

  margin-bottom: 16px;
  padding: 16px;

  border: 1px solid #dce3ec;
  border-radius: 16px;

  background: #f8fafc;
}

.target-action-card h2 {
  margin: 2px 0 5px;

  font-size: 30px;
}

.target-action-card code {
  color: #667085;
}

.target-action-meta {
  display: flex;
  flex-wrap: wrap;

  gap: 6px;
}

.target-action-meta span {
  padding: 5px 8px;

  border-radius: 999px;

  font-size: 12px;

  background: #e9eef5;
}

.warning-pill {
  color: #9f2d24 !important;
  background: #fff0ef !important;
}

.take-preview {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.take-preview strong {
  font-size: 22px;
}

.take-preview code {
  overflow-wrap: anywhere;
}


.capture-advisory {
  display: flex;
  flex-direction: column;

  gap: 4px;

  margin-top: 12px;
  margin-bottom: 12px;

  padding: 11px 13px;

  border-radius: 11px;
}

.capture-advisory-ready {
  border: 1px solid #b7dfc7;

  color: #226a43;
  background: #edf9f1;
}

.capture-advisory-warning {
  border: 1px solid #efaaa4;

  color: #9f2d24;
  background: #fff0ef;
}

.collection-capture-button {
  min-width: 160px;
}

.shortcut-hint {
  margin-top: 7px;

  text-align: right;

  font-size: 12px;
  color: #98a2b3;
}

.collection-notice {
  margin-top: 12px;
  padding: 11px 13px;

  border: 1px solid #cbd7e7;
  border-radius: 10px;

  background: #f4f7fb;
}


.sample-history-panel {
  margin-top: 18px;

  overflow: hidden;

  border: 1px solid #e1e6ed;
  border-radius: 14px;

  background: white;
}

.sample-history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding: 13px 15px;

  border-bottom: 1px solid #edf0f4;
}

.sample-history-header > div {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sample-history-header span {
  font-size: 12px;
  color: #667085;
}

.sample-history-empty {
  padding: 24px;

  text-align: center;

  color: #98a2b3;
}

.sample-history-list {
  display: flex;
  flex-direction: column;
}

.sample-history-row {
  display: grid;

  grid-template-columns:
    minmax(240px, 1.3fr)
    minmax(320px, 2fr)
    auto;

  align-items: center;

  gap: 12px;

  padding: 11px 14px;

  border-bottom: 1px solid #edf0f4;
}

.sample-history-row:last-child {
  border-bottom: none;
}

.sample-history-row-bad {
  background: #fff3f2;
}

.sample-history-main {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.sample-history-main code {
  font-size: 12px;
  overflow-wrap: anywhere;
}

.sample-history-metrics {
  display: flex;
  flex-wrap: wrap;

  gap: 7px;

  font-size: 12px;
  color: #667085;
}

.sample-good-pill,
.sample-bad-pill {
  padding: 3px 7px;

  border-radius: 999px;

  font-weight: 700;
}

.sample-good-pill {
  color: #16794a;
  background: #eaf8f0;
}

.sample-bad-pill {
  color: #b42318;
  background: #feeceb;
}

.sample-delete-button {
  min-height: 34px;

  padding: 6px 11px;

  border: 1px solid #efb2ad;
  border-radius: 8px;

  cursor: pointer;

  font-weight: 700;

  color: #b42318;
  background: white;
}

.sample-delete-button:hover:not(:disabled) {
  background: #fff0ef;
}

.ready-text {
  color: #16794a;
}

.danger-text {
  color: #b42318 !important;
}


@media (
  max-width: 900px
) {
  .collector-toolbar,
  .target-action-card {
    grid-template-columns:
      1fr;
  }

  .collection-summary {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .sample-history-row {
    grid-template-columns:
      1fr;
  }

  .sample-delete-button {
    width: 100%;
  }
}

/* ========================================
   Collector Profile
   ======================================== */

.collector-profile-card {
  display: flex;
  flex-direction: column;

  gap: 13px;

  margin-bottom: 14px;
  padding: 15px;

  border: 1px solid #dfe5ed;
  border-radius: 15px;

  background: #ffffff;
}


.collector-profile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 16px;
}

.collector-profile-header > div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.collector-profile-header span {
  font-size: 12px;
  color: #667085;
}


.collector-profile-grid {
  display: grid;

  grid-template-columns:
    repeat(
      4,
      minmax(130px, 1fr)
    );

  gap: 10px;
}

.collector-profile-grid label,
.collector-note-field {
  display: flex;
  flex-direction: column;

  gap: 5px;
}

.collector-profile-grid label > span,
.collector-note-field > span {
  font-size: 12px;
  font-weight: 700;

  color: #475467;
}

.collector-profile-grid select,
.collector-note-field textarea {
  width: 100%;

  box-sizing: border-box;

  padding: 8px 10px;

  border: 1px solid #d8dee8;
  border-radius: 9px;

  font: inherit;

  background: white;
}

.collector-note-field textarea {
  resize: vertical;

  min-height: 76px;
}

.collector-note-field small {
  align-self: flex-end;

  color: #98a2b3;
}


.collector-consent-field {
  display: flex;
  align-items: flex-start;

  gap: 8px;

  font-size: 12px;
  line-height: 1.5;

  color: #667085;
}

.collector-consent-field input {
  margin-top: 3px;
}


.collector-profile-message {
  padding: 8px 10px;

  border-radius: 8px;

  font-size: 12px;

  color: #246b45;

  background: #eef9f2;
}


@media (
  max-width: 850px
) {
  .collector-profile-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }
}


@media (
  max-width: 520px
) {
  .collector-profile-grid {
    grid-template-columns:
      1fr;
  }

  .collector-profile-header {
    align-items: stretch;
    flex-direction: column;
  }
}


/* ===== SignBridge Workbench Visual Final START ===== */

/* ----------------------------------------
   Collection plan
   ---------------------------------------- */

.collection-profile-panel {
  box-sizing: border-box !important;

  display: flex !important;
  flex-direction: column !important;

  gap: 16px !important;

  margin: 0 0 18px !important;
  padding: 18px !important;

  border: 1px solid #e2e8f0 !important;
  border-radius: 16px !important;

  background: #ffffff !important;

  box-shadow:
    0 7px 24px
    rgba(15, 23, 42, 0.045) !important;
}


.collection-profile-heading {
  display: flex !important;

  justify-content: space-between !important;
  align-items: flex-start !important;

  gap: 18px !important;
}


.collection-profile-heading > div {
  display: flex !important;
  flex-direction: column !important;

  gap: 4px !important;
}


.collection-profile-heading > div > strong {
  margin: 0 !important;

  font-size: 15px !important;
  line-height: 1.4 !important;
  font-weight: 700 !important;

  color: #172033 !important;
}


.collection-profile-heading > div > span {
  font-size: 12px !important;
  line-height: 1.55 !important;

  color: #718096 !important;
}


.collection-profile-heading > strong {
  flex-shrink: 0 !important;

  padding: 6px 11px !important;

  border: 1px solid #dbe3ed !important;
  border-radius: 999px !important;

  font-size: 12px !important;
  font-weight: 700 !important;

  color: #334155 !important;
  background: #f5f7fa !important;
}


.collection-profile-options {
  display: grid !important;

  grid-template-columns:
    repeat(
      4,
      minmax(0, 1fr)
    ) !important;

  gap: 9px !important;
}


.collection-profile-option {
  appearance: none !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;
  justify-content: center !important;

  gap: 4px !important;

  min-width: 0 !important;
  min-height: 66px !important;

  padding: 10px 12px !important;

  border: 1px solid #dce3ec !important;
  border-radius: 11px !important;

  cursor: pointer !important;

  text-align: left !important;

  color: #344054 !important;
  background: #fafbfc !important;

  box-shadow: none !important;

  transition:
    transform 0.15s ease,
    border-color 0.15s ease,
    background 0.15s ease,
    box-shadow 0.15s ease !important;
}


.collection-profile-option:hover:not(:disabled) {
  transform: translateY(-1px) !important;

  border-color: #98a6b9 !important;

  background: #ffffff !important;

  box-shadow:
    0 6px 16px
    rgba(15, 23, 42, 0.06) !important;
}


.collection-profile-option > strong {
  font-size: 14px !important;
  line-height: 1.35 !important;
  font-weight: 700 !important;

  color: inherit !important;
}


.collection-profile-option > span {
  font-size: 12px !important;
  line-height: 1.35 !important;

  color: #7a8799 !important;
}


.collection-profile-option-active {
  transform: none !important;

  border-color: #172033 !important;

  color: #ffffff !important;
  background: #172033 !important;

  box-shadow:
    0 7px 18px
    rgba(15, 23, 42, 0.14) !important;
}


.collection-profile-option-active > span {
  color: #d3dae5 !important;
}


.collection-session-field {
  display: grid !important;

  grid-template-columns:
    72px
    minmax(180px, 260px)
    minmax(0, 1fr) !important;

  align-items: center !important;

  gap: 10px !important;

  padding-top: 14px !important;

  border-top:
    1px solid #edf0f4 !important;
}


.collection-session-field label,
.custom-target-field label {
  margin: 0 !important;

  font-size: 12px !important;
  font-weight: 700 !important;

  color: #536174 !important;
}


.collection-session-field input,
.custom-target-field input {
  box-sizing: border-box !important;

  width: 100% !important;
  min-height: 40px !important;

  padding: 8px 11px !important;

  border: 1px solid #cfd8e4 !important;
  border-radius: 9px !important;

  outline: none !important;

  font: inherit !important;
  font-size: 13px !important;

  color: #172033 !important;
  background: #ffffff !important;

  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease !important;
}


.collection-session-field input:focus,
.custom-target-field input:focus {
  border-color: #7789a2 !important;

  box-shadow:
    0 0 0 3px
    rgba(100, 116, 139, 0.1) !important;
}


.collection-session-field small {
  font-size: 11px !important;
  line-height: 1.5 !important;

  color: #8d99aa !important;
}


.custom-target-field {
  display: grid !important;

  grid-template-columns:
    120px
    120px !important;

  align-items: center !important;

  gap: 10px !important;

  padding: 10px 12px !important;

  border-radius: 10px !important;

  background: #f7f9fb !important;
}


/* ----------------------------------------
   Signer toolbar
   ---------------------------------------- */

.collector-toolbar {
  box-sizing: border-box !important;

  border: 1px solid #e2e8f0 !important;
  border-radius: 15px !important;

  background: #f8fafc !important;

  box-shadow: none !important;
}


.quick-signer,
.countdown-option {
  appearance: none !important;

  border: 1px solid #d8e0ea !important;
  border-radius: 9px !important;

  color: #344054 !important;
  background: #ffffff !important;
}


.quick-signer-active,
.countdown-option-active {
  border-color: #60738e !important;

  color: #172033 !important;
  background: #ffffff !important;

  box-shadow:
    0 0 0 2px
    rgba(96, 115, 142, 0.12) !important;
}


/* ----------------------------------------
   Collector profile
   ---------------------------------------- */

.collector-profile-card {
  box-sizing: border-box !important;

  margin-bottom: 16px !important;
  padding: 18px !important;

  border: 1px solid #e2e8f0 !important;
  border-radius: 16px !important;

  background: #ffffff !important;

  box-shadow:
    0 6px 22px
    rgba(15, 23, 42, 0.035) !important;
}


.collector-profile-grid select,
.collector-note-field textarea {
  border: 1px solid #d4dce7 !important;
  border-radius: 9px !important;

  color: #172033 !important;
  background: #ffffff !important;
}


.collector-profile-grid select:focus,
.collector-note-field textarea:focus {
  outline: none !important;

  border-color: #7c8ba0 !important;

  box-shadow:
    0 0 0 3px
    rgba(100, 116, 139, 0.1) !important;
}


/* ----------------------------------------
   Dynamic workbench sidebar
   ---------------------------------------- */

.workbench-sidebar-card {
  box-sizing: border-box !important;

  display: flex !important;
  flex-direction: column !important;

  width: 100% !important;

  padding: 26px !important;

  border: 1px solid #e1e7ee !important;
  border-radius: 22px !important;

  color: #172033 !important;
  background: #ffffff !important;

  box-shadow:
    0 15px 42px
    rgba(15, 23, 42, 0.065) !important;
}


.workbench-sidebar-eyebrow {
  margin: 0 0 12px !important;

  font-size: 12px !important;
  line-height: 1.4 !important;
  font-weight: 600 !important;

  letter-spacing: 0.02em !important;

  color: #8a97a8 !important;
}


.workbench-sidebar-target {
  display: flex !important;
  flex-direction: column !important;

  gap: 5px !important;

  padding-bottom: 20px !important;

  border-bottom:
    1px solid #edf1f5 !important;
}


.workbench-sidebar-target h2 {
  margin: 0 !important;

  font-size: 30px !important;
  line-height: 1.15 !important;
  font-weight: 750 !important;

  color: #111827 !important;
}


.workbench-sidebar-target code {
  margin: 0 !important;

  font-family: inherit !important;
  font-size: 12px !important;

  color: #8d99aa !important;

  background: transparent !important;
}


.workbench-sidebar-section {
  display: flex !important;
  flex-direction: column !important;

  margin: 8px 0 0 !important;
}


.workbench-status-row {
  display: flex !important;

  justify-content: space-between !important;
  align-items: center !important;

  gap: 16px !important;

  min-height: 47px !important;

  border-bottom:
    1px solid #f0f3f6 !important;
}


.workbench-status-row > span {
  flex-shrink: 0 !important;

  font-size: 12px !important;
  font-weight: 500 !important;

  color: #8491a3 !important;
}


.workbench-status-row > strong {
  max-width: 66% !important;

  text-align: right !important;

  font-size: 13px !important;
  line-height: 1.35 !important;
  font-weight: 700 !important;

  color: #172033 !important;
}


.workbench-status-good {
  color: #18794e !important;
}


.workbench-status-warning {
  color: #b5473b !important;
}


.workbench-sidebar-readiness {
  box-sizing: border-box !important;

  margin-top: 16px !important;
  padding: 11px 12px !important;

  border-radius: 10px !important;

  font-size: 12px !important;
  line-height: 1.55 !important;
}


.workbench-sidebar-readiness-good {
  border: 1px solid #c5e5d2 !important;

  color: #216a48 !important;
  background: #f0faf4 !important;
}


.workbench-sidebar-readiness-warning {
  border: 1px solid #f1c7c1 !important;

  color: #9e392f !important;
  background: #fff4f2 !important;
}


.workbench-capture-state {
  display: flex !important;

  justify-content: space-between !important;
  align-items: center !important;

  gap: 12px !important;

  margin-top: 14px !important;
  padding: 11px 12px !important;

  border-radius: 10px !important;

  background: #f6f8fa !important;
}


.workbench-capture-state > span {
  font-size: 12px !important;

  color: #8491a3 !important;
}


.workbench-capture-state > strong {
  font-size: 13px !important;
  font-weight: 700 !important;

  color: #172033 !important;
}


.workbench-sidebar-primary {
  appearance: none !important;

  display: flex !important;

  align-items: center !important;
  justify-content: center !important;

  width: 100% !important;
  min-height: 50px !important;

  margin-top: 16px !important;
  padding: 0 16px !important;

  border: 0 !important;
  border-radius: 11px !important;

  cursor: pointer !important;

  font: inherit !important;
  font-size: 14px !important;
  font-weight: 700 !important;

  color: #ffffff !important;
  background: #172033 !important;

  box-shadow: none !important;

  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease,
    background 0.15s ease !important;
}


.workbench-sidebar-primary:hover:not(:disabled) {
  transform:
    translateY(-1px) !important;

  background: #0f172a !important;

  box-shadow:
    0 8px 20px
    rgba(15, 23, 42, 0.17) !important;
}


.workbench-sidebar-primary:disabled {
  transform: none !important;

  cursor: not-allowed !important;

  color: #a2aab7 !important;
  background: #f0f2f5 !important;

  box-shadow: none !important;
}


.workbench-sidebar-tip {
  margin: 12px 0 0 !important;

  font-size: 11px !important;
  line-height: 1.6 !important;

  color: #8996a7 !important;
}


/* ----------------------------------------
   Slightly improve overall workbench
   ---------------------------------------- */

.camera-panel {
  border-radius: 20px !important;
}


.collection-summary > div {
  border-color: #e4e9ef !important;

  background: #ffffff !important;

  box-shadow:
    0 3px 12px
    rgba(15, 23, 42, 0.025) !important;
}


.sign-progress-card {
  border-color: #e0e6ed !important;

  background: #ffffff !important;

  box-shadow: none !important;
}


.sign-progress-card-active {
  border-color: #687b96 !important;

  background: #f8fafc !important;

  box-shadow:
    inset 0 0 0 1px
    rgba(104, 123, 150, 0.18) !important;
}


.target-action-card {
  border-color: #e0e6ed !important;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f8fafc
    ) !important;
}


/* ----------------------------------------
   Responsive
   ---------------------------------------- */

@media (
  max-width: 900px
) {
  .collection-profile-options {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      ) !important;
  }


  .collection-profile-heading {
    flex-direction:
      column !important;
  }


  .collection-session-field {
    grid-template-columns:
      1fr !important;
  }


  .workbench-sidebar-card {
    padding:
      20px !important;
  }
}


@media (
  max-width: 520px
) {
  .collection-profile-options {
    grid-template-columns:
      1fr !important;
  }
}

/* ===== SignBridge Workbench Visual Final END ===== */



/* ===== SignBridge Sidebar History Final START ===== */

.collection-capture-button {
  min-width: 300px !important;
  min-height: 64px !important;

  padding: 0 30px !important;

  font-size: 19px !important;
  font-weight: 750 !important;

  border-radius: 14px !important;
}


.workbench-sidebar-primary {
  width: 100% !important;
  min-height: 66px !important;

  padding: 0 20px !important;

  font-size: 19px !important;
  font-weight: 750 !important;

  border-radius: 14px !important;
}


.workbench-recent-samples {
  margin-top: 18px !important;
  padding-top: 16px !important;

  border-top:
    1px solid #e8edf3 !important;
}


.workbench-recent-samples-header {
  display: flex !important;

  align-items: center !important;
  justify-content: space-between !important;

  gap: 10px !important;

  margin-bottom: 10px !important;
}


.workbench-recent-samples-header strong {
  font-size: 14px !important;
  font-weight: 750 !important;

  color: #172033 !important;
}


.workbench-recent-samples-header span {
  font-size: 11px !important;

  color: #8491a3 !important;
}


.workbench-recent-samples-empty {
  padding: 16px 8px !important;

  text-align: center !important;

  font-size: 12px !important;

  color: #98a2b3 !important;
}


.workbench-recent-samples-list {
  display: flex !important;

  flex-direction: column !important;

  gap: 7px !important;

  max-height: 380px !important;

  overflow-y: auto !important;

  padding-right: 3px !important;
}


.workbench-recent-sample {
  padding: 9px 10px !important;

  border:
    1px solid #e5eaf0 !important;

  border-radius: 10px !important;

  background: #ffffff !important;
}


.workbench-recent-sample-bad {
  border-color: #efc4be !important;

  background: #fff5f3 !important;
}


.workbench-recent-sample-top {
  display: flex !important;

  align-items: center !important;
  justify-content: space-between !important;

  gap: 8px !important;
}


.workbench-recent-sample-top strong {
  font-size: 12px !important;

  color: #172033 !important;
}


.workbench-recent-sample-good {
  font-size: 11px !important;
  font-weight: 700 !important;

  color: #18794e !important;
}


.workbench-recent-sample-warning {
  font-size: 11px !important;
  font-weight: 700 !important;

  color: #b5473b !important;
}


.workbench-recent-sample-metrics {
  display: flex !important;

  flex-wrap: wrap !important;

  gap: 5px 9px !important;

  margin-top: 6px !important;

  font-size: 10px !important;

  color: #7c899b !important;
}

/* ===== SignBridge Sidebar History Final END ===== */
